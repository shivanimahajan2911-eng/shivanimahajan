"""

def split_bill(total_bill, people):
    try:
        share = total_bill / people
        print(f"Each person pays: ${share:.2f}")
    except ZeroDivisionError:
        print("Error: You cannot split a bill among zero people!")

# Example call
split_bill(150.00, 0)
