def register_user():
    try:
        age = int(input("Enter your age for registration: "))
        if age < 0 or age > 120:
            raise ValueError("Age must be between 0 and 120.")
        print(f"Registration successful! Age: {age}")
    except ValueError as e:
        print(f"Invalid Input: {e}")

# Example call
register_user()
