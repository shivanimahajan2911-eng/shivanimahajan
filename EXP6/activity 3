filename = "complaints.txt"

print("--- List of Complaints ---")
try:
    with open(filename, "r") as file:
        content = file.read()
        if content:
            print(content)
        else:
            print("The complaint file is currently empty.")
except FileNotFoundError:
    print("Error: complaints.txt file not found.")
