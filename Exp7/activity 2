class Student:
    def __init__(self):
        self.marks = 80

    def grade(self):
        if self.marks >= 75:
            print("Grade: A")
        elif self.marks >= 50:
            print("Grade: B")
        else:
            print("Fail")

s = Student()
s.grade()
