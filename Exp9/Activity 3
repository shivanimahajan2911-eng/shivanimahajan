import math

# Coordinates
x1, y1 = 3, 4
x2, y2 = 7, 10

# Distance formula: sqrt((x2-x1)^2 + (y2-y1)^2)
distance = math.sqrt(math.pow(x2 - x1, 2) + math.pow(y2 - y1, 2))

print(f"Distance between points: {round(distance, 2)}")


