import streamlit as st

# Title and header
st.title("Student Result Calculator")
st.header("Enter Student Details")

# User input
name = st.text_input("Enter Student Name:")

sub1 = st.number_input("Enter Marks of Subject 1:", min_value=0, max_value=100)
sub2 = st.number_input("Enter Marks of Subject 2:", min_value=0, max_value=100)
sub3 = st.number_input("Enter Marks of Subject 3:", min_value=0, max_value=100)

# Button
if st.button("Calculate Result"):

    total = sub1 + sub2 + sub3
    percentage = total / 3

    st.success("Result Calculated Successfully!")

    st.write("Student Name:", name)
    st.write("Total Marks:", total)
    st.write("Percentage:", percentage)

    # Grade
    if percentage >= 75:
        st.write("Grade: A")
    elif percentage >= 50:
        st.write("Grade: B")
    elif percentage >= 35:
        st.write("Grade: C")
    else:
        st.write("Grade: Fail")

# Display text and markdown
st.markdown("### Student Result App")
st.text("This is simple Streamlit application")
