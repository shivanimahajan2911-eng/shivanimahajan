import streamlit as st

# Title
st.title("🛒 Grocery Bill Calculator")

st.write("Enter grocery items and their prices to calculate total bill.")

# Number of items
num_items = st.number_input("How many items?", min_value=1, step=1)

total = 0

# Input for each item
for i in range(int(num_items)):
    st.subheader(f"Item {i+1}")
    
    item_name = st.text_input(f"Enter item name {i+1}")
    item_price = st.number_input(f"Enter price of {item_name if item_name else 'item'}", min_value=0.0, step=1.0, key=i)
    
    total += item_price

# Display total
st.markdown("---")
st.success(f"Total Grocery Bill = ₹{total:.2f}")
